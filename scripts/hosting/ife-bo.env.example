# Incorporar estas variables al .env EXISTENTE del servidor. No reemplazarlo.
# Conservar APP_KEY, credenciales DB, correo y servicios ya configurados.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ife.bo
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file
GOOGLE_CONTACTS_PROCESS_MODE=cron
GOOGLE_CONTACTS_CRON_INTERVAL=5
GOOGLE_REDIRECT=https://ife.bo/auth/google/callback
# Configurar GOOGLE_OAUTH_ID y GOOGLE_OAUTH_SECRET del cliente web correcto.
# Los tokens se obtienen desde AdminLTE y se guardan cifrados en la base.
